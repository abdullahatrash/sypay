---
import { LOCALES, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
const t = useTranslations(Astro.currentLocale as Lang);
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";

import heroImageAr from "@/assets/hero-mobile.svg";
import heroImageEn from "@/assets/hero-mobile.svg";
import heroImageJa from "@/assets/ja/hero.svg";
import heroImageZhCn from "@/assets/zh-cn/hero.svg";
import featureImage from "@/assets/featureImage.svg";
import newsLetterImage from "@/assets/newsletter.svg";
import { Image } from "astro:assets";

const locale = Astro.currentLocale as Lang;

export const getStaticPaths = async () =>
  Object.keys(LOCALES).map((lang) => ({
    params: { lang },
  }));

// Get blog posts
const posts = await getCollection("blog");
---

<Layout>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-background"></div>
    <div class="hero-container">
      <div class="hero-content">
        <h1>{t({ en: "Banking, but for digital creators", ja: "デジタルクリエイターのための銀行", "zh-cn": "为数字创作者提供的银行���务", ar: "البنك للمبدعين الرقميين" })}</h1>
        <p class="hero-description">
          {t({
            en: "Designed by creators, for creators. Untitled gives you the guidance, data, and innovation you need to sell more and grow your digital business.",
            ja: "クリエイターによって設計された、クリエイターのための銀行。Untitledは、より多く販売し、デジタルビジネスを成長させるためのガイダンス、データ、イノベーションを提供します。",
            "zh-cn": "由创作者设计，为创作者服务。Untitled为您提供指导、数据和创新，帮助您销售更多产品并发展您的数字业务。",
            ar: "تم تصميمه من قبل المبدعين وللمبدعين. Untitled يمنحك الإرشادات والبيانات والابتكار اللازمين لزيادة مبيعاتك وتنمية عملك الرقمي."
          })}
        </p>
        <div class="hero-buttons">
          <a href={getRelativeLocaleUrl(locale, "setup")} class="primary-button">
            {t({ en: "Text me a link", ja: "リンクを送る", "zh-cn": "发给我一个链接", ar: "ارسل لي رابطًا" })}
          </a>
          <a href={`https://docs.astro.build/${locale}/guides/internationalization/`} target="_blank" class="secondary-button">
            {t({ en: "View Docs", ja: "ドキュメントを見る", "zh-cn": "查看文档", ar: "عرض المستندات" })}
            <span class="material-icons-sharp dir">open_in_new</span>
          </a>
        </div>
      </div>
      <div class="hero-image">
        <Image
          src={
            locale === "ja"
              ? heroImageJa
              : locale === "zh-cn"
              ? heroImageZhCn
              : locale === "ar"
              ? heroImageAr
              : heroImageEn
          }
          alt={t({ ja: "こんにちは", en: "Hello", "zh-cn": "你好", ar: "مرحبًا" })}
          loading="eager"
        />
      </div>
    </div>
  </section>
  <!-- Hero Section End -->
  <!-- Features Section Start -->
  <section class="features">
    <div class="features-container">
      <div class="features-text">
        <p class="features-heading">{t({ en: "Features", ja: "特徴", "zh-cn": "功能", ar: "الميزات" })}</p>
        <h2>{t({ en: "Unlock yourself", ja: "自分を解放する", "zh-cn": "解锁自己", ar: "اكتشف ذاتك" })}</h2>
        <p class="features-description">
          {t({
            en: "Daily personalized fitness, sleep, and recovery data delivered to you in real time with Untitled. We're changing how you move.",
            ja: "Untitledを使って、毎日の個別フィットネス、睡眠、回復データがリアルタイムで配信されます。私たちは、あなたの動きを変えています。",
            "zh-cn": "通过 Untitled 实时为您提供个性化的每日健身、睡眠和恢复数据。我们正在改变您的运动方式。",
            ar: "يتم تسليم بيانات اللياقة الشخصية والنوم والتعافي يوميًا في الوقت الفعلي باستخدام Untitled. نحن نغير طريقتك في الحركة."
          })}
        </p>
      </div>
      <div class="features-content">
        <div class="features-list">
          <div class="feature-item">
            <h3>{t({ en: "Share team inboxes", ja: "チームの受信トレイを共有", "zh-cn": "共享团队收件箱", ar: "مشاركة صناديق بريد الفريق" })}</h3>
            <p>
              {t({
                en: "Whether you have a team of 2 or 200, our shared team inboxes keep everyone on the same page and in the loop.",
                ja: "2人から200人のチームでも、共有チーム受信トレイで全員が同���ページにアクセスし続けることができます��",
                "zh-cn": "无论您拥有 2 人或 200 人的团队，我们的共享团队收件箱可让每个人持同步并了解最新信息。",
                ar: "سواء كان لديك فريق مكون من 2 أو 200 شخص، فإن صناديق البريد المشتركة لفريقنا تبقي الجميع على نفس الصفحة."
              })}
            </p>
            <a href="#" class="learn-more">{t({ en: "Learn more →", ja: "もっと詳しく→", "zh-cn": "了解更多 →", ar: "تعرف على المزيد →" })}</a>
          </div>
          <div class="feature-item">
            <h3>{t({ en: "Deliver instant answers", ja: "即時の回答を提供", "zh-cn": "提供即时答案", ar: "تقديم الإجابات الفورية" })}</h3>
            <p>
              {t({
                en: "An all-in-one customer service platform that helps you balance everything your customers need to be happy.",
                ja: "お客様が満足するために必要なすべてをバランスよく管理するオールインワンカスタマーサービスプラットフォーム。",
                "zh-cn": "一体化的客户服务平台，帮助您平衡客户的所有需求，使他们满意。",
                ar: "منصة خدمة عملاء شاملة تساعدك على تحقيق التوازن بين كل ما يحتاجه عملاؤك ليكونوا سعداء."
              })}
            </p>
            <a href="#" class="learn-more">{t({ en: "Learn more →", ja: "もっと詳しく→", "zh-cn": "了解更多 →", ar: "تعرف على المزيد →" })}</a>
          </div>
          <div class="feature-item">
            <h3>{t({ en: "Manage your team with reports", ja: "レポートでチームを管理", "zh-cn": "使用报告管理您的团队", ar: "إدارة فريقك بالتقارير" })}</h3>
            <p>
              {t({
                en: "Measure what matters with Untitled's easy-to-use reports. You can filter, export, and drill down on the data in a couple clicks.",
                ja: "Untitledの使いやすいレポートで重要なものを測定できます。数回のクリックでデータをフィルタリング、エクスポート、掘り下げることができます。",
                "zh-cn": "使用 Untitled 易于使用的报告衡量重要事项。您可以通过几次点击筛选、导出和深入分析数据。",
                ar: "قم بقياس ما يهمك باستخدام التقارير سهلة الاستخدام من Untitled. يمكنك التصفية والتصدير وتحليل ا��بيانات في بضع نقرات."
              })}
            </p>
            <a href="#" class="learn-more">{t({ en: "Learn more →", ja: "もっと詳しく→", "zh-cn": "了解更多 →", ar: "تعرف على المزيد →" })}</a>
          </div>
        </div>
        <div class="features-image">
          <Image src={featureImage} alt={t({ en: "Dashboard feature", ja: "ダッシュボード機能", "zh-cn": "仪表盘功能", ar: "ميزة لوحة المعلومات" })} />
        </div>
      </div>
    </div>
  </section>
  <!-- Add this after the Features Section -->
  <section class="blog">
    <div class="blog-container">
      <div class="blog-header">
        <h2>{t({ en: "Latest writings", ja: "最新の記事", "zh-cn": "最新文章", ar: "أحدث المقالات" })}</h2>
        <p>{t({ 
          en: "The latest news, technologies, and resources from our team.", 
          ja: "チームからの最新ニュース、テクノロジー、リソース。",
          "zh-cn": "来自我们团队的最新新闻、技术和资源。",
          ar: "آخر الأخبار والتقنيات والموارد من فريقنا."
        })}</p>
      </div>

      <div class="blog-grid">
        {
          posts
          .filter((post) => post.slug.split("/")[0] === locale)
          .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
          .slice(0, 3)
          .map((post) => {
            const [, ...slug] = post.slug.split("/");
            return (
              <a href={`/${locale}/blog/${slug.join("/")}/`} class="blog-card">
                {post.data.cover && (
                  <div class="blog-image">
                    <Image src={post.data.cover} alt={post.data.title} />
                  </div>
                )}
                <div class="blog-content">
                  <h3>{post.data.title}</h3>
                  <div class="blog-meta">
                    <time datetime={post.data.date.toISOString()}>
                      {post.data.date.toLocaleDateString(locale)}
                    </time>
                  </div>
                </div>
              </a>
            );
          })}
      </div>

      <div class="blog-footer">
        <a href={`/${locale}/blog`} class="view-all">
          {t({ en: "View all posts", ja: "すべての記事を見る", "zh-cn": "查看所有文章", ar: "عرض جميع المقالات" })}
          <span class="material-icons-sharp dir">arrow_forward</span>
        </a>
      </div>
    </div>
  </section>
  <!-- Add this after the blog section -->
  <section class="faq">
    <div class="faq-container">
      <div class="faq-header">
        <h2>{t({ en: "Frequently asked questions", ja: "よくある質問", "zh-cn": "常见问题", ar: "الأسئلة الشائعة" })}</h2>
        <p>{t({ 
          en: "Everything you need to know about the product and billing.", 
          ja: "製品と請求について知っておくべきすべてのこと。",
          "zh-cn": "关于产品和账单您需要了解的一切。",
          ar: "كل ما تحتاج إلى معرفته حول المنتج والفواتير."
        })}</p>
      </div>

      <div class="accordion">
        <div class="accordion-item">
          <button class="accordion-header" aria-expanded="true">
            <span>{t({ en: "Is there a free trial available?", ja: "無料トライアルはありますか？", "zh-cn": "有免费试用吗？", ar: "هل هناك نسخة تجريبية مجانية؟" })}</span>
            <svg class="icon" viewBox="0 0 24 24"><path d="M11 11V5h2v6h6v2h-6v6h-2v-6H5v-2z"/></svg>
          </button>
          <div class="accordion-content">
            <p>{t({ 
              en: "Yes, you can try us for free for 30 days. If you want, we'll provide you with a free, personalized 30-minute onboarding call to get you up and running as soon as possible.", 
              ja: "はい、30日間無料でお試しいただけます。ご希望の場合は、できるだけ早くご利用いただけるよう、30分の無料パーソナライズドオンボーディングコールをご提供いたします。",
              "zh-cn": "是的，您可以免费试用30天。如果您愿意，我们将为您提供30分钟的免费个性化入门指导，帮助您尽快开始使用。",
              ar: "نعم، يمكنك تجربتنا مجانًا لمدة 30 يومًا. إذا أردت، سنوفر لك مكالمة تعريفية مجانية ومخصصة لمدة 30 دقيقة لمساعدتك على البدء في أسرع وقت ممكن."
            })}</p>
          </div>
        </div>

        <!-- Add more accordion items as needed -->
      </div>
    </div>
  </section>
  <!-- Add this after the FAQ section -->
  <section class="newsletter">
    <div class="newsletter-container">
      <div class="newsletter-content">
        <h2>{t({ 
          en: "Be the first to know when we launch", 
          ja: "ローンチ時にいち早く知ることができます", 
          "zh-cn": "成为第一个知道我们发布的人", 
          ar: "كن أول من يعرف عندما نطلق" 
        })}</h2>
        <p>{t({ 
          en: "We're still building. Subscribe for updates and 20% off when we launch. No spam, we promise!", 
          ja: "現在構築中です。アップデート情報を購読すると、ローンチ時に20%オフになります。スパムはありません！", 
          "zh-cn": "我们仍在构建中。订阅更新可在发布时获得20%的折扣。我们保证不会发送垃圾邮件！", 
          ar: "ما زلنا في مرحلة البناء. اشترك للحصول على التحديثات وخصم 20٪ عند الإطلاق. لا بريد مزعج، نعد بذلك!" 
        })}</p>
        
        <form class="newsletter-form">
          <div class="input-group">
            <input 
              type="email" 
              placeholder={t({ 
                en: "Enter your email", 
                ja: "メールアドレスを入力", 
                "zh-cn": "输入您的邮箱", 
                ar: "أدخل بريدك الإلكتروني" 
              })}
              required
            />
            <button type="submit" class="subscribe-button">
              {t({ 
                en: "Subscribe", 
                ja: "購読する", 
                "zh-cn": "订阅", 
                ar: "اشترك" 
              })}
            </button>
          </div>
          <p class="privacy-notice">
            {t({ 
              en: "We care about your data in our", 
              ja: "私たちはあなたのデータを大切にします", 
              "zh-cn": "我们重视您的数据在我们的", 
              ar: "نحن نهتم ببياناتك في" 
            })} 
            <a href="#">{t({ 
              en: "privacy policy", 
              ja: "プライバシーポリシー", 
              "zh-cn": "隐私政策", 
              ar: "سياسة الخصوصية" 
            })}</a>.
          </p>
        </form>
      </div>
      <div class="newsletter-image">
        <Image 
          src={newsLetterImage} 
          alt={t({ 
            en: "Newsletter illustration", 
            ja: "ニュースレターのイラスト", 
            "zh-cn": "新闻通讯插图", 
            ar: "رسم توضيحي للنشرة الإخبارية" 
          })} 
        />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Modern Hero Section Styles */
  .hero {
  position: relative;
  width: 100%;
  padding: 2rem 0;
  margin-inline: calc(50% - 50vw); /* Full-width background */
  overflow: hidden;
  background-color: #f9fafb;
}

.hero-background {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom right,
    rgba(109, 40, 217, 0.05),
    rgba(37, 99, 235, 0.05)
  );
  z-index: -1;
}

.hero-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1rem;
  align-items: center;
}

.hero-content {
  order: 0;
  text-align: left;
  align-self: center;
}
  /* RTL Specific Adjustments */
  :dir(rtl) {
    .hero-content {
      text-align: right;
    }
  }

.hero-content h1 {
  font-size: clamp(2.5rem, 4vw, 3rem);
  font-weight: 700;
  margin-bottom: 1rem;
}

.hero-content .hero-description {
  font-size: 1.2rem;
  margin-bottom: 2rem;
  color: #6b7280;
}

.hero-buttons {
  display: flex;
  gap: 1rem;
}

.hero-image {
  display: flex;
  justify-content: center;
  align-items: center;
}

.hero-image img {
  width: 100%;
  max-width: 400px;
  height: auto;
  animation: float 6s ease-in-out infinite;
}

.primary-button {
  background-color: #4f46e5;
  color: #fff;
  padding: 0.8rem 1.5rem;
  border-radius: 9999px;
  font-weight: 600;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  transition: background-color 0.3s ease;
}

.primary-button:hover {
  background-color: #4338ca;
}

.secondary-button {
  background-color: #e5e7eb;
  color: #111827;
  padding: 0.8rem 1.5rem;
  border-radius: 9999px;
  font-weight: 600;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  transition: background-color 0.3s ease;
}

.secondary-button:hover {
  background-color: #d1d5db;
}

/* Animation for floating image */
@keyframes float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}

/* Responsive Design */
@media (max-width: 768px) {
  .hero-container {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .hero-image {
    order: 0;
  }

  .hero-content {
    order: 1;
  }

  .hero-content h1 {
    font-size: 2rem;
  }

  .hero-buttons {
    justify-content: center;
  }
}
.features {
  padding: 2rem 1rem;
  background-color: #f9fafb;
}

.features-container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.features-text {
  text-align: center;
  margin-bottom: 2rem;
}

.features-heading {
  font-size: 1rem;
  font-weight: bold;
  color: #6b46c1;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
}

.features-description {
  color: #4a5568;
  font-size: 1.2rem;
}

.features-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: center;
}

.features-list {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.feature-item h3 {
  font-size: 1.5rem;
  margin-bottom: 0.5rem;
}

.feature-item p {
  margin-bottom: 1rem;
  color: #4a5568;
}

.learn-more {
  color: #6b46c1;
  text-decoration: none;
  font-weight: bold;
  font-size: 1rem;
}

.features-image img {
  width: 100%;
  max-width: 500px;
  display: block;
  margin: 0 auto;
}

@media (max-width: 768px) {
  .features-content {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .features-image img {
    max-width: 100%;
  }
}

/* Add these styles */
.blog {
  padding: 4rem 1rem;
  background: white;
}

.blog-container {
  max-width: 1200px;
  margin: 0 auto;
}

.blog-header {
  text-align: center;
  margin-bottom: 3rem;
}

.blog-header h2 {
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: #111827;
}

.blog-header p {
  color: #6b7280;
  font-size: 1.2rem;
}

.blog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  margin-bottom: 3rem;
}

.blog-card {
  text-decoration: none;
  color: inherit;
  background: white;
  border-radius: 0.5rem;
  overflow: hidden;
  box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  transition: transform 0.2s ease-in-out;

  &:hover {
    transform: translateY(-4px);
  }
}

.blog-image {
  aspect-ratio: 16/9;
  overflow: hidden;

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
}

.blog-content {
  padding: 1.5rem;

  h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #111827;
  }
}

.blog-meta {
  display: flex;
  gap: 1rem;
  color: #6b7280;
  font-size: 0.875rem;
}

.blog-footer {
  text-align: center;
}

.view-all {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.5rem;
  background-color: #4f46e5;
  color: white;
  text-decoration: none;
  border-radius: 9999px;
  font-weight: 600;
  transition: background-color 0.2s ease-in-out;

  &:hover {
    background-color: #4338ca;
  }

  .material-icons-sharp {
    font-size: 1.25rem;
  }
}

/* RTL Support */
:dir(rtl) {
  .blog-content {
    text-align: right;
  }

  .blog-meta {
    justify-content: flex-end;
  }

  .view-all {
    flex-direction: row-reverse;
  }
}

/* Responsive Design */
@media (max-width: 768px) {
  .blog-grid {
    grid-template-columns: 1fr;
  }

  .blog-header h2 {
    font-size: 2rem;
  }
}

/* Add these styles */
.faq {
  padding: 4rem 1rem;
  background-color: #f9fafb;
}

.faq-container {
  max-width: 800px;
  margin: 0 auto;
}

.faq-header {
  text-align: center;
  margin-bottom: 3rem;
}

.faq-header h2 {
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: #111827;
}

.faq-header p {
  color: #6b7280;
  font-size: 1.2rem;
}

.accordion {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.accordion-item {
  border-radius: 0.5rem;
  background: white;
  box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
}

.accordion-header {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem;
  border: none;
  background: none;
  text-align: left;
  font-size: 1.1rem;
  font-weight: 500;
  color: #111827;
  cursor: pointer;

  .icon {
    width: 24px;
    height: 24px;
    fill: currentColor;
    transition: transform 0.2s ease;
  }

  &[aria-expanded="true"] .icon {
    transform: rotate(45deg);
  }
}

.accordion-content {
  padding: 0 1.5rem;
  height: 0;
  overflow: hidden;
  opacity: 0;
  transition: all 0.2s ease-out;

  p {
    padding-bottom: 1.5rem;
    color: #6b7280;
  }
}

.accordion-item .accordion-header[aria-expanded="true"] + .accordion-content {
  height: auto;
  opacity: 1;
}

/* RTL Support */
:dir(rtl) {
  .accordion-header {
    text-align: right;
    flex-direction: row-reverse;
  }
}

/* Responsive Design */
@media (max-width: 768px) {
  .faq-header h2 {
    font-size: 2rem;
  }
}

